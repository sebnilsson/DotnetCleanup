<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <OutputType>Exe</OutputType>

    <Title>dotnet-cleanup</Title>
    <AssemblyName>DotnetCleanup</AssemblyName>
    <PackageId>dotnet-cleanup</PackageId>
    <PackageVersion>$(Version)</PackageVersion>
    <Version>1.0.0</Version>

    <ToolCommandName>dotnet-cleanup</ToolCommandName>
    <PackAsTool>True</PackAsTool>
    <PackageOutputPath>./nupkg</PackageOutputPath>

    <PackageProjectUrl>https://github.com/sebnilsson/DotnetCleanup</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <RepositoryUrl>$(PackageProjectUrl).git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <Authors>Sebastian Nilsson</Authors>
    <Description>.NET Global Tool for cleaning up build output and dependency folders.</Description>
    <Summary>.NET Global Tool for cleaning up build output and dependency folders.</Summary>

    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" />
    <PackageReference Include="Spectre.Console.Cli" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DotnetCleanup.Tests" />
    <InternalsVisibleTo Include="DotnetCleanup.IntegrationTests" />
  </ItemGroup>

</Project>
